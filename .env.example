# --- Hindsight (memory backend) ---
# Required if running docker-compose.yml with a real Hindsight server.
OPENAI_API_KEY=sk-xxx
HINDSIGHT_LLM_PROVIDER=openai

# --- OpsMind backend ---
# Point at your own Hindsight server / Hindsight Cloud if not using docker-compose.
HINDSIGHT_API_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_TENANT=default

OPSMIND_BANK_PREFIX=opsmind
OPSMIND_DB_PATH=./opsmind.db
OPSMIND_HOST=0.0.0.0
OPSMIND_PORT=8000
OPSMIND_RECALL_LIMIT=5
